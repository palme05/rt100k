{
  "name": "rt100k",
  "version": "0.0.0",
  "private": true,
  "description": "Road to 100k – selbst gehosteter Open-Source-Vermögenstracker",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.ts",
    "test:db": "vitest run --config vitest.db.config.ts"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.11",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "better-auth": "1.7.11",
    "drizzle-orm": "^0.45.4",
    "next": "^16.4.2",
    "pdfjs-dist": "6.4.299",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "uqr": "^0.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.2",
    "lefthook": "^2.2.2",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
