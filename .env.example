# Vorlage – echte Werte nur als Vercel-Env-Vars bzw. in .env.local (nie committen).

# Neon Postgres: App-Rolle rt100k_app (nur DML, RLS greift), Pooler, nur TLS
DATABASE_URL="postgresql://rt100k_app:***@ep-***-pooler.eu-central-1.aws.neon.tech/rt100k?sslmode=require&channel_binding=require"
# Owner-Rolle nur für Migrationen (lokal/Betreiber, nie in der Laufzeit-App)
DATABASE_URL_MIGRATIONS=""

# Better Auth (mind. 32 Byte Zufall: openssl rand -base64 32)
BETTER_AUTH_SECRET=""
# Nur für Schlüsseltausch mit bestehenden Konten (Ablauf: docs/EINRICHTUNG.md, Schritt 5)
# BETTER_AUTH_SECRETS="1:<neuer Wert>"
# Öffentliche URL (Produktion fest; Previews nehmen automatisch die Branch-URL)
BETTER_AUTH_URL="http://localhost:3000"

# Schutz für /api/cron/daily (openssl rand -base64 32)
CRON_SECRET=""

# Optional: CoinGecko-Demo-Key (kostenlos, ohne Kreditkarte) für höhere Limits
COINGECKO_API_KEY=""

# Nur Tests/CI: feste Testkurse statt echter Abrufe (in Produktion gesperrt)
# RT100K_QUOTES="fixture"
# Admin-Zugang zur lokalen Test-Datenbank für pnpm test:db und E2E
# DATABASE_URL_TEST_ADMIN="postgres://postgres:***@127.0.0.1:5432/postgres"
