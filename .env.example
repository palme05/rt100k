# Vorlage – echte Werte nur als Vercel-Env-Vars bzw. in .env.local (nie committen).

# Neon Postgres (App-Rolle ohne DDL-Rechte, nur TLS) – ab Phase 2
DATABASE_URL="postgresql://rt100k_app:***@***.eu-central-1.aws.neon.tech/rt100k?sslmode=require&channel_binding=require"
# Separate Rolle nur für Migrations (lokal/CI, nie in der Laufzeit-App)
DATABASE_URL_MIGRATIONS=""

# Better Auth – ab Phase 2 (mind. 32 Byte Zufall: openssl rand -base64 32)
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Schutz für Cron-/Alarm-Endpunkte (openssl rand -base64 32)
CRON_SECRET=""
